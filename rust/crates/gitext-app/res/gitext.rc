// Windows resources of gitext.exe: the application icon and the icons of the Explorer
// context menu (same ids as GitExtensionsShellEx, see src/shell_ext.rs). build.rs fills in
// the @...@ placeholders.
#include <winver.h>

1   ICON "@ICONS@/git-extensions-logo.ico"
202 ICON "@ICONS@/FileStatusAdded.ico"
203 ICON "@ICONS@/ShellExtensions.ico"
204 ICON "@ICONS@/BranchCreate.ico"
205 ICON "@ICONS@/BranchCheckout.ico"
206 ICON "@ICONS@/checkout.ico"
209 ICON "@ICONS@/CloneRepoGit.ico"
210 ICON "@ICONS@/RepoStateClean.ico"
211 ICON "@ICONS@/FileHistory.ico"
212 ICON "@ICONS@/Pull.ico"
213 ICON "@ICONS@/Push.ico"
214 ICON "@ICONS@/ResetWorkingDirChanges.ico"
215 ICON "@ICONS@/Settings.ico"
216 ICON "@ICONS@/Diff.ico"
217 ICON "@ICONS@/stash.ico"
218 ICON "@ICONS@/RepoCreate.ico"
219 ICON "@ICONS@/PatchApply.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VERSION_COMMA@
PRODUCTVERSION  @VERSION_COMMA@
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Git Extensions"
            VALUE "FileDescription",  "Git Extensions"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "gitext"
            VALUE "LegalCopyright",   "GNU General Public License v3"
            VALUE "OriginalFilename", "gitext.exe"
            VALUE "ProductName",      "Git Extensions"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
