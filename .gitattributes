* text=auto
*.rs text diff=rust
*.patch diff -text
*.blame diff -text
*.xml diff -text
*.bat text eol=crlf
*.cmd text eol=crlf
*.yml text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf

# Approval files of the ported tests (rust/testdata) must keep their exact bytes
*.bin binary diff=text
*RevisionReaderTests.*.approved.* binary diff=text
*DoAutoCRLF*.approved.* binary diff=text
